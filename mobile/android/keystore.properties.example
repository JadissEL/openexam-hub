# Copy to keystore.properties (gitignored). Do not commit the keystore or these passwords.
# Environment variables of the same names override this file:
# OEH_UPLOAD_STORE_FILE, OEH_UPLOAD_STORE_PASSWORD, OEH_UPLOAD_KEY_ALIAS, OEH_UPLOAD_KEY_PASSWORD

storeFile=/absolute/path/to/openexam-hub-upload.jks
storePassword=replace-me
keyAlias=upload
keyPassword=replace-me
