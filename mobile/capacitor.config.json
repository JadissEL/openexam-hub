{
  "appId": "org.openexamhub.app",
  "appName": "OpenExam Hub",
  "webDir": "dist",
  "android": {
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#F7F5F0"
    },
    "Keyboard": {
      "resize": "native"
    }
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  }
}
