# Copy to .env.local for local dev. In production set these in Vercel -> Settings -> Environment Variables.
# Never commit real values.

# ---------------- Server (Vercel functions in api/**) ----------------
# Service-account JSON on ONE line (Firebase console -> Project settings -> Service accounts). Secret.
FIREBASE_SERVICE_ACCOUNT=
# Firestore namespace artifacts/{APP_ID}/...; must equal VITE_APP_ID. Default: openexam-hub
APP_ID=
# Project id when not taken from the service account (emulator/local only). Optional.
FIREBASE_PROJECT_ID=
# CORS origin for /api, e.g. https://openexam-hub.vercel.app. Default: *
ALLOWED_ORIGIN=
# Random string; Vercel cron sends it as Bearer to /api/cron/*. Secret.
CRON_SECRET=
# Random string; Bearer token for /api/admin/*. Secret.
ADMIN_SECRET=

# LLM gateway (OpenAI-compatible, e.g. self-hosted OmniRoute), base URL including /v1.
LLM_BASE_URL=
# Gateway API key (OmniRoute Dashboard -> Endpoints). Secret.
LLM_API_KEY=
# Default model/combo for all agents. Default: auto
LLM_MODEL=
# Per-agent override: LLM_MODEL_DISCOVERY / _PLANNER / _FORMAT / _DIAGNOSTIC / _COACH / _PRACTICE / _EXPANSION. Optional.
LLM_MODEL_PLANNER=
# Optional second OpenAI-compatible endpoint used when the primary fails.
LLM_FALLBACK_BASE_URL=
# Key for the fallback endpoint. Secret.
LLM_FALLBACK_API_KEY=
# Model id on the fallback endpoint.
LLM_FALLBACK_MODEL=

# Donations (webhooks)
# Secret typed when creating the GitHub Sponsors webhook (HMAC X-Hub-Signature-256). Secret.
GITHUB_SPONSORS_WEBHOOK_SECRET=
# Ko-fi verification token (ko-fi.com/manage/webhooks -> Advanced). Secret.
KOFI_VERIFICATION_TOKEN=
# Random string appended to the Open Collective webhook URL as ?token=. Secret.
OPEN_COLLECTIVE_WEBHOOK_TOKEN=
# Your Open Collective slug; other accounts are ignored.
OPEN_COLLECTIVE_SLUG=
# Optional Open Collective personal token (only raises GraphQL rate limits). Secret.
OPEN_COLLECTIVE_API_TOKEN=
# FX rates to EUR (FX_<CUR>_EUR). USD is effectively required (GitHub Sponsors pays in USD).
FX_USD_EUR=
FX_GBP_EUR=
FX_JPY_EUR=

# Library: extra official domains, comma-separated bare hostnames (mirror in src/App.jsx allowlist). Optional.
EXTRA_ALLOWED_DOMAINS=

# Set to 1 only AFTER scripts/migrate-v3.mjs has run on this project (new library writes then use v3 ids).
RESOURCE_IDS_V3=

# ---------------- Client (Vite, baked in at build time; all optional) ----------------
# Defaults in src/firebaseConfig.js are the public openexam-hub web config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must equal server APP_ID. Default: openexam-hub
VITE_APP_ID=
# API origin; empty = same-origin /api (this Vercel project).
VITE_API_BASE=
# Set to false to build a preview-only UI that never calls /api. Default: true
VITE_SERVER_ENABLED=

# ---------------- Local / test only (scripts/*) ----------------
# Set automatically by npm run e2e; points firebase-admin at the emulator.
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=
LOCAL_API_PORT=
LOCAL_SERVER_QUIET=
MOCK_LLM_PORT=
MOCK_LLM_KEY=
