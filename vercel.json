{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/*.js": {
      "maxDuration": 300
    },
    "api/admin/*.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/recheck-links",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rollup",
      "schedule": "30 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "openexam-hub.vercel.app"
        }
      ],
      "destination": "https://openexamhub.org/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.openexamhub.org"
        }
      ],
      "destination": "https://openexamhub.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/ads-txt"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/((?!api/|blog(?:/|$)|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "fra1"
  ]
}
