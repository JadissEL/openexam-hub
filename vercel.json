{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/*.js": {
      "maxDuration": 300
    },
    "api/admin/*.js": {
      "maxDuration": 300
    },
    "api/generate-roadmap.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/recheck-links",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rollup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/warm-plans",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/transparency",
      "destination": "/funding",
      "permanent": true
    },
    {
      "source": "/transparency/",
      "destination": "/funding",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/tools/clb-converter",
      "permanent": true
    },
    {
      "source": "/tools/",
      "destination": "/tools/clb-converter",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "openexam-hub.vercel.app"
        }
      ],
      "destination": "https://openexamhub.org/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.openexamhub.org"
        }
      ],
      "destination": "https://openexamhub.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/ads-txt"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/((?!api/|blog(?:/|$)|demo(?:/|$)|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/app/index.html"
    }
  ],
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/demo/desktop.vtt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vtt; charset=utf-8"
        }
      ]
    }
  ]
}
