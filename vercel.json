{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/recheck-links.js": {
      "maxDuration": 300
    },
    "api/admin/expand.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/recheck-links",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "fra1"
  ]
}
